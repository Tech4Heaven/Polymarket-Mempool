# Where target trades are detected from: polynode | onchain | both (default: both).
#   polynode = PolyNode pending-settlement mempool feed only (~3–5s before on-chain confirmation).
#   onchain  = legacy OrderFilled log subscription + receipt (post-mining; ~2 blocktimes slower).
#   both     = PolyNode primary + on-chain fallback, deduped by (tx, target). Recommended.
# DETECTION_SOURCE=both

# PolyNode API key (pn_live_...). REQUIRED when DETECTION_SOURCE is `polynode` or `both`.
# Get one at https://polynode.dev (Starter plan covers a single copy bot).
# POLYNODE_API_KEY=pn_live_YOUR_KEY

# WebSocket endpoint for Polygon. Used by the on-chain OrderFilled subscription (onchain/both).
# Any provider works (Alchemy, Chainstack, Infura, …) — the watcher subscribes to standard
# `eth_subscribe logs` with server-side topic filters on the CTF Exchange V2 `OrderFilled` event,
# so only events involving one of your target traders are pushed. ~50–500 events/day — any free tier.
# Not required when DETECTION_SOURCE=polynode.
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# HTTP endpoint used for receipt fetching after a target event fires.
# Can be the same provider as POLYGON_WSS_URL, or split (e.g. Chainstack HTTP + Alchemy WSS).
# Falls back to POLYGON_HTTP_URL or a public node if unset.
# POLYGON_MEMPOOL_HTTP_URL=https://polygon-mainnet.core.chainstack.com/YOUR_KEY

# --- Target list & copy sizing: TOML vs .env
#
# If `copy-targets.toml` exists in the project root (see `copy-targets.toml.example`), it defines
# all trader addresses and per-address copy settings. In that case TARGET_TRADER_ADDRESSES and the
# COPY_RATIO / MAX_PRICE_DIFFERENCE / COPY_BUY_PRICE_* / MIN_* / MAX_* block below are ignored for copy trading.
# Shared CLOB settings remain in `.env` for the whole project.
#
# Optional: path to a different TOML file (default: copy-targets.toml next to package.json).
# COPY_TARGETS_TOML=copy-targets.toml
#
# Legacy (no TOML file): comma-separated trader addresses to watch and (when copy is enabled) mirror.
TARGET_TRADER_ADDRESSES=0x0000000000000000000000000000000000000000

# Optional: override which exchange contracts to watch (defaults to CTF + Neg-Risk V2 from Polymarket docs).
# EXCHANGE_ADDRESSES=0xE111180000d2663C0091e4f400237545B87B996B,0xe2222d279d744050d28e00520010520000310F59

# Optional: limit concurrent getTransaction calls when pending traffic is heavy (default 5).
# MAX_CONCURRENT_TX_LOOKUPS=5

# ---- Withdrawal watcher
# Polls each target wallet's cash + positions and alerts on the console when funds leave the wallet
# (a trader rotating to a fresh address to dodge copy bots shows up as funds draining out).
# WITHDRAWAL_POLL_MINUTES=3      # how often to poll each target (default 3)
# WITHDRAWAL_ALERT_USD=50        # net cash outflow above this (USD) triggers an alert (default 50)

# ---- Copy trading (CLOB V2)
#
# With `copy-targets.toml`: keep shared CLOB values here; TOML only stores targets and per-target sizing.
# With legacy .env only: use COPY_TRADING_ENABLED and the variables below.
#
# COPY_TRADING_ENABLED=false
# (dry-run is now per-target via the `dry_run = true` field in copy-targets.toml)
#
# Legacy-only sizing (ignored when TOML is present):
# COPY_RATIO=1
# MAX_PRICE_DIFFERENCE=0.05
# (buy only: skip if clob price > implied + this; sells ignore this check)
# COPY_BUY_PRICE_MIN=     # optional 0–1; omit = no floor on buy limit price
# COPY_BUY_PRICE_MAX=     # optional 0–1; omit = no cap (typical: max you will pay per share)
# MIN_POSITION_USDC=1
# MAX_POSITION_USDC=500
#
# COPY_WALLET_PRIVATE_KEY=   # hex; optional when using JSON-based credentials instead
# COPY_WALLET_KEY_JSON=      # optional path to JSON file (relative to project root or absolute)
# COPY_WALLET_JSON_FIELD=    # optional; only if your JSON uses a non-default property name for the hex value
# (L2 API key/secret/passphrase come from createOrDeriveApiKey() — not set in env)
# CLOB_SIGNATURE_TYPE=0
# FUNDER_ADDRESS=
# POLYGON_HTTP_URL=https://polygon-bor.publicnode.com
# CLOB_HOST=https://clob.polymarket.com
#
# Legacy log file: single target uses this or copy-trades.log; multiple targets use logs/<username>_<address>.log
# COPY_TRADE_LOG_PATH=copy-trades.log

# ---- Fill simulation (dry-run only)
#
# When a target is in dry-run (`dry_run = true` in copy-targets.toml), the bot can simulate how the
# order it "would post" actually fills — against REAL live market flow (Polymarket market websocket:
# book + trades) — instead of just logging the intended order. Because your order is never really in
# the book, queue position is unknowable, so each fill/PnL is reported as a [pessimistic, optimistic]
# RANGE. Output goes to the per-target log with a `[SIM]` prefix (grep `[SIM]`). Read-only, no auth;
# it does nothing in real mode.
#
# On by default whenever a target is in dry-run. Set to false to turn it off entirely.
# SIMULATE_FILLS=true
#
# Max time a simulated order is tracked before it's closed as `ttl` (hours). Should cover the
# target's typical hold time (this desk's tweet-market trader holds ~4 days). Default 120 (5 days).
# SIM_MAX_HOLD_HOURS=120

# ---- Telegram resolution notifications (optional)
#
# When set, the P&L reconciler sends a Telegram card every time a market the bot entered resolves:
# win/loss + your P&L, your side vs winner, fills → payout, the TARGET's real P&L with the delta vs
# yours, and this target's running today / all-time totals (plus a drawdown-paused note if hit).
# Leave either blank to disable (sends become no-ops). Get a token from @BotFather; TELEGRAM_CHAT_ID
# is your user or channel id (message @userinfobot / @getidsbot to find it).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
