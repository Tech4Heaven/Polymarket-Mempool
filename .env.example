# WebSocket endpoint for Polygon that supports `eth_subscribe` / pending transactions.
# Many public RPCs do not expose the full mempool; dedicated providers (Alchemy, Infura, Chainstack, etc.) often do.
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Comma-separated trader addresses to flag when they appear as order `maker` or `signer`
# (matches Polymarket proxy wallet / Safe / EOA used in signed orders).
TARGET_TRADER_ADDRESSES=0x0000000000000000000000000000000000000000

# Optional: override which exchange contracts to watch (defaults to CTF + Neg-Risk V2 from Polymarket docs).
# EXCHANGE_ADDRESSES=0xE111180000d2663C0091e4f400237545B87B996B,0xe2222d279d744050d28e00520010520000310F59

# Optional: limit concurrent getTransaction calls when pending traffic is heavy (default 5).
# MAX_CONCURRENT_TX_LOOKUPS=5

# ---- Copy trading (CLOB V2) — set COPY_TRADING_ENABLED=true to post mirrored orders after a mined target fill
# COPY_TRADING_ENABLED=false
# COPY_TRADING_DRY_RUN=true
# (when enabled: same CLOB checks as live, but no order is submitted)
# COPY_RATIO=1
# MAX_PRICE_DIFFERENCE=0.05
# (buy only: skip if clob price > implied + this; sells ignore this check)
# MIN_POSITION_USDC=1
# MAX_POSITION_USDC=500
# COPY_WALLET_PRIVATE_KEY=   # 64 hex chars (MetaMask export) or 0x + 64 hex
# (L2 API key/secret/passphrase come from createOrDeriveApiKey() — not set in env)
# CLOB_SIGNATURE_TYPE=0
# FUNDER_ADDRESS=
# POLYGON_HTTP_URL=https://polygon-bor.publicnode.com
# CLOB_HOST=https://clob.polymarket.com
# Optional: where to append lines for successful copy (dry or live). Default: copy-trades.log in project root.
# COPY_TRADE_LOG_PATH=copy-trades.log
