# Copy this to `copy-targets.toml` (or set COPY_TARGETS_TOML to another path).
# Shared CLOB settings (wallet key, signature type, funder, host URLs) live in `.env`.
# This TOML defines watched target wallets + per-target sizing + per-target dry-run flag.

[defaults]
# Defaults for every [[targets]] row (each field can be overridden per target)
copy_ratio = 1
# Overbid skip: when effective ask > target's implied by more than this, skip the copy
# (market moved up faster than us — we'd pay too much).
max_price_difference = 0.1
# Underbid skip (optional): when effective ask < target's implied by more than this, skip the copy
# (market re-priced AWAY from target's side in the gap between their fill and ours — strong
# signal the target's read is wrong). Omit = no underbid skip (mirror at the cheaper price).
# max_underbid_difference = 0.15
# Underbid skip, PROPORTIONAL (optional, 0–1). Skip the copy when the price has fallen more than this
# FRACTION below the target's entry:  effective < implied × (1 - max_underbid_frac).
# Use this to tell a genuine cheap entry from a collapsed one — an absolute cap can't, because the
# same gap means different things at different prices (0.29 is routine from 0.60, fatal from 0.30):
#   entry 0.60 → 0.01 = 98% drop → skip      entry 0.30 → 0.01 = 97% drop → skip
#   entry 0.01 → 0.01 =  0% drop → COPY  (a genuine 1¢ buy; buy_price_min would wrongly reject it)
# Ignores drops smaller than 2 ticks, so tick noise on cheap markets doesn't trip it.
# Set together with max_underbid_difference to also cap high-price entries: the absolute rule takes
# over above entry = max_underbid_difference / max_underbid_frac (e.g. 0.3 / 0.5 = 0.60).
# max_underbid_frac = 0.5
# Buy only: optional absolute outcome price bounds in [0, 1] (omit either side for no limit)
# NOTE: buy_price_min is an ABSOLUTE floor — it rejects every cheap buy, including ones where the
# target itself entered that low. Prefer max_underbid_frac if that's what you're trying to prevent.
# buy_price_min = 0.05
# buy_price_max = 0.85
min_position_usdc = 1
max_position_usdc = 100
# When true, copy decisions are logged but no order is posted to CLOB. Default: false (live trading)
# dry_run = false
# After each copy BUY, place a passive GTC limit BUY on the OPPOSITE outcome at this price (in [0,1]),
# sized to total holdings of the primary side in that condition. Acts as a cheap pre-hedge.
# When the target later buys the opposite side themselves, we suppress that copy (already hedged).
# Omit = no hedging.
# hedge_price = 0.10
# Hedge size as a FRACTION of the filled main position (0 < x <= 1). Default 1 = fully balance
# (hedge shares == main shares). e.g. 0.5 = hedge only 50% of the main. The hedge is capped at this
# fraction of the main and never chases past it, so it can't balloon larger than the main.
# hedge_token_percent = 0.5
# Per-SIDE max USDC cap. The most USDC this target can cause us to commit to a single outcome
# (Up and Down each get their own bucket — total per market can reach 2× this value).
# Buys are clipped to fit; full sells reset the side. Omit = no cap.
# max_market_usdc = 100
# ACCOUNT-WIDE per-market cap (env, not toml): set MAX_MARKET_USDC_ACCOUNT in .env to cap the combined
# USDC on a single outcome token summed across ALL targets on this wallet. Enforced alongside each
# target's max_market_usdc (whichever binds first). Omit = no account-wide cap.
# Whether the withdrawal watcher polls this wallet for fund outflows (alerts if funds drain out —
# a sign the trader may be rotating to a new address). Default false — opt in per target.
# watch_withdrawals = true
# If true, buys that would be skipped by the CLOB's per-market `min_order_size` (typically 5 shares)
# are accumulated per (target, tokenId). The bot posts ONE combined order when the next buy on the
# same side brings the combined share count above min_order_size. Default false.
# Useful for targets that trade in tiny share counts you'd otherwise drop. Buffer expires after 15
# min idle; cleared on a sell of the same token (target exit) and on a successful flush.
# Note: this does NOT buffer min_position_usdc skips — set min_position_usdc = 0 if you want to
# rely solely on min_order_size as the floor.
# accumulate_below_min = true
# When a BUY is skipped for "price drift buy" (CLOB moved above the target's on-chain implied by
# more than max_price_difference), keep watching that market for this many seconds and REPOST the
# buy if the price falls back to within max_price_difference. Each skipped order reposts when the
# price returns to within maxΔ of its own target implied. Default 120. Set 0 to disable re-watching.
# Only affects the overbid drift skip — never the underbid skip. Polls the book every ~1s.
# drift_rewatch_seconds = 120
# Ceiling on the drift (effective - implied) at skip time for a skip to be re-watched at all. A drift
# far above max_price_difference means the market repriced hard; if it snaps back it's usually a new
# regime, not the original signal, so we drop it instead of chasing. Must exceed max_price_difference.
# Example: max_price_difference = 0.1, drift_rewatch_max = 0.2 → re-watch skips with drift in (0.1, 0.2];
# a skip at drift 0.15 is re-watched, a skip at 0.3 is dropped. Default 0.2.
# drift_rewatch_max = 0.2
# Auto-stop (drawdown circuit breaker). Positive USD loss caps on this target's REALIZED P&L
# (from resolved markets in the P&L ledger). When breached, the bot halts NEW copies for the target
# (existing positions can still be exited via sells). Omit either to disable that limit.
#   max_drawdown_per_day: stop once today's (UTC) realized P&L <= -this; auto-resumes next UTC day.
#   max_drawdown_total:   stop once all-time realized P&L <= -this; stays stopped until P&L recovers
#                         above the cap or you raise/remove the limit.
# max_drawdown_per_day = 50
# max_drawdown_total = 200
# Taker fill improvement — make buys cross the ask and fill instead of resting (thin books).
#   taker_bump:          price added ABOVE the best ask (0-1 units; 0.02 = 2 cents). Omit/0 = maker-style.
#   max_taker_bump_frac: caps the bump to this fraction of the ask so low prices aren't over-paid
#                        (0.10 = at most 10% of price). Tick-aware: if one tick would exceed the cap it
#                        posts at the ask (no bump). Default 0.10 when taker_bump is set.
# Example: ask 0.58 → posts 0.60 (2c bump, ~3.4%); ask 0.10 → posts 0.11 (capped to 10%); ask 0.01 on a
# 0.01-tick market → posts 0.01 (bump would be a full-tick 100% overpay, so it's skipped).
# Applied after the drift check; buy_price_max still caps the final price.
# taker_bump = 0.02
# max_taker_bump_frac = 0.10
# Sell fill improvement — the EXIT mirror of taker_bump. Make copied sells cross BELOW the bid and fill
# instead of resting on a bid that can vanish in fast markets (which would leave you holding a position
# the target already sold). Omit/0 = maker-style (post at the top bid).
#   sell_bump:          price subtracted BELOW the best bid (0-1 units; 0.02 = 2 cents).
#   max_sell_bump_frac: caps the bump to this fraction of the bid (default 0.10). Tick-aware.
# sell_bump = 0.02
# max_sell_bump_frac = 0.10
# Reprice-until-filled for sells. If a copied sell still rests unfilled, cancel the remainder and
# re-post at a fresh aggressive price, chasing the market down until filled / out of attempts / past the
# deadline / below the slippage floor (then the remainder is abandoned rather than dumped at any price).
#   sell_reprice_attempts:    max reprice cycles (0/omit = disabled; the sell posts once).
#   sell_reprice_deadline_ms: stop repricing this many ms after the first post (default 2500).
#   sell_max_slippage_frac:   never reprice below implied × (1 - this). Omit = no floor (chase to book).
# sell_reprice_attempts = 4
# sell_reprice_deadline_ms = 2500
# sell_max_slippage_frac = 0.15
# Restrict copying to specific crypto "Up or Down" assets (ALLOWLIST). A single asset or a list; values
# match the market slug prefix, long names aliased (bitcoin→btc, ethereum→eth, …). When set, trades on
# any other asset — and any non-crypto market — are skipped (a cache miss is skipped too). Resolved
# network-free from a background cache (no gamma call on the copy path). Omit = copy every market.
# market = "btc"                  # or:  market = ["btc", "eth"]
# Fresh-wallet bait guard. Skips a target's small "test" positions until he opens a real one: his spend
# is tallied PER market and every trade in a market whose running total stays below new_wallet_min_usd
# is skipped — across every market — until SOME market reaches the threshold (proof he's really trading),
# after which all his trades copy normally. Defeats the "open a tiny position to lure copiers, then
# withdraw" tactic. Persisted across restarts. Uses HIS spend, not your copy size (copy_ratio doesn't
# affect it). Omit/false = copy from the first trade.
#   new_wallet_min_usd: USD threshold that marks a market as "real" (default 150).
# new_wallet = true
# new_wallet_min_usd = 150
# Protective take-profit. After each copied BUY fills, rest a GTC SELL of that position at this price
# (0,1) — typically 0.99. A maker order (no fee) that locks the value if the price spikes there, dodging
# the 99¢→1¢ flip at resolution. If the target sells first, the resting order is cancelled and his sell
# is copied. Cannot be combined with hedge_price (both manage the position's protective order). Omit = off.
# safe_sell = 0.99
# Copy only the target's MAIN side. Some traders buy BOTH outcomes of a market (a self-hedge); copying
# both guarantees a losing leg. When true, copy the FIRST outcome he buys in each market and SKIP any buy
# on the opposite outcome (his hedge/second leg) — a clean directional copy. Pair with hedge_price to add
# your OWN protective hedge instead of mirroring his. Persisted per market across restarts. Omit/false =
# copy both sides.
# main_side_only = true
# Master enable/disable for the row. When false, the bot does NOTHING for this address — no copy,
# no mempool match, no withdrawal poll. Default true. Handy to temporarily pause a target without
# deleting its config.
# enabled = false

[[targets]]
address = "0xe71a099e3a4499458de60a1daba70ab649cd6944"
# username = "MyLabel"            # optional; used in log filename; if omitted, resolved from Polymarket public-profile API

[[targets]]
address = "0x0000000000000000000000000000000000000001"
copy_ratio = 0.5
max_price_difference = 0.05
dry_run = true                    # this target is in dry-run mode while you observe it
hedge_price = 0.10                # pre-hedge opposite outcome at 10¢ after each copy BUY

# Mempool watcher and shared CLOB credentials still use `.env`.
