/**
 * PM2 config for the copy bot.
 *
 * Wallet passphrase comes from process.env.COPY_WALLET_KEY_PASSPHRASE — set transiently
 * by ./start-bot.sh (interactively-entered, never stored on disk). The bot reads it via
 * src/promptWalletPassphrase.ts at startup instead of prompting.
 *
 * Start:        ./start-bot.sh
 * Logs:         pm2 logs bot
 * Stop:         pm2 stop bot
 * Restart:      pm2 restart bot   (reuses cached env; no re-prompt needed)
 * Delete:       pm2 delete bot    (next start needs ./start-bot.sh again)
 *
 * The `relay` app is the shared PolyNode fan-out (src/polynodeRelay.ts) — run it on ONE host only
 * (the one whose .env has POLYNODE_API_KEY); every bot connects to it via POLYNODE_RELAY_URL. It
 * needs no wallet passphrase, so start it on its own and BEFORE the bots:
 *   pm2 start ecosystem.config.cjs --only relay
 *   pm2 logs relay
 * On hosts that only run bots (no key), delete the `relay` app entry below.
 * The `buy-ui` app is the BTC Manual Buy web UI (scripts/manualBuyServer.ts) — run it alongside
 * the bot as a separate PM2 process (does not share the bot process):
 *   ./start-buy-ui.sh
 *   pm2 logs buy-ui
 *   http://127.0.0.1:3847
 */

const path = require("path");
const cwd = __dirname;

module.exports = {
  apps: [
    {
      name: "bot",
      script: path.join(cwd, "node_modules", "tsx", "dist", "cli.mjs"),
      args: "src/index.ts",
      cwd,
      interpreter: "node",
      instances: 1,
      exec_mode: "fork",
      max_restarts: 50,
      restart_delay: 5_000,
      min_uptime: "30s",
      out_file: path.join(cwd, "logs", "pm2-out.log"),
      error_file: path.join(cwd, "logs", "pm2-err.log"),
      merge_logs: true,
      time: true,
      max_memory_restart: "2G",
      env: {
        NODE_ENV: "production",
        // Path to encrypted wallet JSON, relative to cwd. Override to a different file if
        // your wallet has a different name; defaults inside the bot use euqoriueusu.json.
        // COPY_WALLET_KEY_JSON: "euqoriueusu.json",
        COPY_WALLET_KEY_PASSPHRASE: process.env.COPY_WALLET_KEY_PASSPHRASE,
      },
    },
    {
      name: "buy-ui",
      script: path.join(cwd, "node_modules", "tsx", "dist", "cli.mjs"),
      args: "scripts/manualBuyServer.ts",
      cwd,
      interpreter: "node",
      instances: 1,
      exec_mode: "fork",
      max_restarts: 50,
      restart_delay: 5_000,
      min_uptime: "10s",
      out_file: path.join(cwd, "logs", "pm2-buy-ui-out.log"),
      error_file: path.join(cwd, "logs", "pm2-buy-ui-err.log"),
      merge_logs: true,
      time: true,
      max_memory_restart: "1G",
      env: {
        NODE_ENV: "production",
        BUY_UI_HOST: process.env.BUY_UI_HOST || "127.0.0.1",
        BUY_UI_PORT: process.env.BUY_UI_PORT || "3847",
      },
    },
    {
      // Shared PolyNode fan-out relay. Run on the key-holding host only (delete elsewhere).
      name: "relay",
      script: path.join(cwd, "node_modules", "tsx", "dist", "cli.mjs"),
      args: "src/polynodeRelay.ts",
      cwd,
      interpreter: "node",
      instances: 1,
      exec_mode: "fork",
      max_restarts: 50,
      restart_delay: 5_000,
      min_uptime: "30s",
      out_file: path.join(cwd, "logs", "pm2-relay-out.log"),
      error_file: path.join(cwd, "logs", "pm2-relay-err.log"),
      merge_logs: true,
      time: true,
      max_memory_restart: "512M",
      env: {
        NODE_ENV: "production",
        // Relay reads POLYNODE_API_KEY from .env. Optionally override listen host/port:
        // POLYNODE_RELAY_PORT: "8787",
        // POLYNODE_RELAY_HOST: "127.0.0.1",
      },
    },
  ],
};
